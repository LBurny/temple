#!name=Mextin订阅解密
#!desc=解密【订阅加密】的下发内容（Base64 + AES-256-GCM），让 Surge 直接使用加密订阅。使用前：①改 surge/script/mextin-decode.js 里的 SUBSCRIPTION_PASSWORD；②把下方 hostname 换成你的订阅域名。
#!author=Minis

[Script]
Mextin Sub Decode = type=http-response,pattern=^https?://.+(/api/v1/client/subscribe|/link/|/subscribe|/sub/|\?list=),requires-body=1,max-size=0,timeout=60,script-path=https://raw.githubusercontent.com/LBurny/temple/main/surge/script/mextin-decode.js

[MITM]
hostname = %APPEND% scesa.web.ak005.com, scesa.apiv2.a047.com
