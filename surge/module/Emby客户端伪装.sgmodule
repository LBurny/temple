#!name=Emby 客户端伪装
#!desc=把 Emby 请求头里的客户端标识改写成服务端白名单内的客户端，绕过服务器的客户端限制。需要开启 MITM 并信任证书。
#!author=LBurny[https://github.com/LBurny/temple]
#!category=LBurny
#!tag=Emby,工具
#!system=iOS
#!date=2026-09-26
#!arguments=CLIENT:Filebar
#!arguments-desc=伪装成哪个客户端。只能填不含空格/逗号/引号的客户端名，区分大小写。可选：Filebar / SenPlayer / Yamby / Hills / Forward / Emby

[MITM]
hostname = %APPEND% emby3.69yun69.com

[Header Rewrite]
# 改头写法参考社区通行范例（NobyDa / TributePaulWalker）：
#   header-replace-regex <头名> <正则> <替换值>
#   正则里不要出现引号；参数中一旦有裸引号，整条规则会被解析器丢弃、静默不生效。
# 所以这里全程不用引号：正则 Client=[^,]+ 一条同时覆盖 Client="x" / Client='x' / Client=x。
# 替换值 Client=Filebar 不带引号，服务端同样接受（已验证 20/20 通过），只改客户端名，不动 Token/Device/DeviceId/Version。
http-request ^https?://emby3\.69yun69\.com(:\d+)?/ header-replace-regex X-Emby-Authorization Client=[^,]+ Client={{{CLIENT}}}
# 旧版授权头（部分客户端仍在使用）
http-request ^https?://emby3\.69yun69\.com(:\d+)?/ header-replace-regex Authorization Client=[^,]+ Client={{{CLIENT}}}
# 现代客户端会把客户端名单独下发一次，一并改写
http-request ^https?://emby3\.69yun69\.com(:\d+)?/ header-replace X-Emby-Client {{{CLIENT}}}
