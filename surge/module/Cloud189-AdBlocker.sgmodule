#!name=天翼云盘去广告
#!desc=移除天翼云盘(189.cn)开屏广告、页内广告、轮播/推荐位、首页横幅、分享推荐与第三方统计埋点。
#!author=LBurny[https://github.com/LBurny/temple]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/189.png
#!category=BetaModule
#!openUrl=https://apps.apple.com/cn/app/id471636624
#!tag=去广告
#!system=iOS
#!date=2026-08-20

[Rule]
# ---------- 纯统计/外部域名 整域拦截 (无需 MITM) ----------
# ux.21cn.com 天翼云盘腾讯灯塔(Beacon)统计 SDK: 行为上报 + 可视化埋点任务下发
DOMAIN,ux.21cn.com,REJECT-NO-DROP
# 云图/授权分类统计域名
DOMAIN,api.yuntu.21cn.com,REJECT-NO-DROP
# 电信生活服务/外部配置域名
DOMAIN,e.dlife.cn,REJECT-NO-DROP

# ---------- 埋点/采集路径 (业务主域名,需 MITM,路径级 REJECT) ----------
# 用户行为采集
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/collectRecords\.action",REJECT,extended-matching
# 用户行为加密上报 (v2Report)
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/v2Report\/userActionReportEncrypt\.action",REJECT,extended-matching
# 登录/场景信息采集 (上传手机号、设备型号、IP 等)
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/userInventoryCollect",REJECT,extended-matching
# IP 归属查询 (广告归因/推送定位)
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/getAttributionByIp\.action",REJECT,extended-matching
# 记录上报 (埋点)
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/listRecords\.action",REJECT,extended-matching

# ---------- 广告位/推广位 (屏蔽后对应卡片消失) ----------
# 开屏广告
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/guns\/getOpenscreenBanners\.action",REJECT,extended-matching
# 首页轮播广告
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/guns\/getCarouselAds\.action",REJECT,extended-matching
# 各页面 Banner 广告 (全 serviceType)
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/guns\/getPageBanners\.action",REJECT,extended-matching
# 首页皮肤/推广横幅
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/guns\/getHomePageSkinBanner\.action",REJECT,extended-matching
# "我的"页推荐位列表
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/guns\/getMyPageRecommendedPositionList\.action",REJECT,extended-matching
# 收藏有奖卡片推荐
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/guns\/collectLabelCard\/getRecCollectLabelCardList\.action",REJECT,extended-matching
# 相册精选推荐卡片
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/album\/listRecommendCards\.action",REJECT,extended-matching
# 金刚位卡片 (首页推广位入口)
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/api\/client\/myCards\.action",REJECT,extended-matching
# 优惠券推广接口
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/coupon\/selectCoupons",REJECT,extended-matching
# 绿色成长体系/推广活动列表
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/market\/getGreenLevelList\.action",REJECT,extended-matching
# 分享页推荐资源
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/share\/getRecResourceShare\.action",REJECT,extended-matching
# 分享页订阅推广
URL-REGEX,"^https?:\/\/api\.cloud\.189\.cn\/share\/getOwnerSubscribeShare\.action",REJECT,extended-matching
# 闪屏广告配置源 (cloud.189.cn)
URL-REGEX,"^https?:\/\/cloud\.189\.cn\/(include\/splash\/splashconfig\.xml|download\/client\/configs\/cloud_router\.json)",REJECT,extended-matching

[MITM]
hostname = %APPEND% api.cloud.189.cn, cloud.189.cn
