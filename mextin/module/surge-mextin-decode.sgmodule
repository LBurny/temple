#!name=Mextin 加密订阅解密
#!desc=解密 Mextin「订阅加密」的下发内容（Base64 + AES-256-GCM），让 Surge 能直接使用。使用前：①把脚本文件里的 SUBSCRIPTION_PASSWORD 改成你的机场订阅加密密码；②把下面 hostname 换成你的订阅域名。
#!author=Minis
#!homepage=https://example.com/docs

[Script]
Mextin Sub Decode = type=http-response,pattern=^https?://.+(/api/v1/client/subscribe|/link/|/subscribe|/sub/|\?list=),requires-body=1,max-size=0,timeout=60,script-path=https://raw.githubusercontent.com/LBurny/temple/main/mextin/script/mextin-decode.js

[MITM]
hostname = %APPEND% scesa.web.ak005.com, scesa.apiv2.a047.com, checkhere.top
