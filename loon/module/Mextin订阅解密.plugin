#!name=Mextin订阅解密
#!desc=解密【订阅加密】的下发内容（Base64 + AES-256-GCM），让 Loon 直接使用加密订阅。使用前：①改 loon/script/mextin-decode.js 里的 SUBSCRIPTION_PASSWORD；②把下方 hostname 换成你的订阅域名。
#!type=plugin
#!author=Minis

[General]

[Script]
http-response ^https?://.+(/api/v1/client/subscribe|/link/|/subscribe|/sub/|\?list=) script-path=https://raw.githubusercontent.com/LBurny/temple/main/loon/script/mextin-decode.js, requires-body=true, timeout=60, tag=Mextin订阅解密

[Mitm]
hostname = scesa.web.ak005.com, scesa.apiv2.a047.com
