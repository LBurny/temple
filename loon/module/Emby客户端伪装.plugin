#!name=Emby 客户端伪装
#!desc=把 Emby 请求头里的客户端标识改写成服务端白名单内的客户端，绕过服务器的客户端限制。需要开启 MITM 并信任证书。
#!author=LBurny[https://github.com/LBurny/temple]
#!homepage=https://github.com/LBurny/temple
#!tag=Emby,工具
#!system=iOS

[MITM]
hostname = %APPEND% emby3.69yun69.com

[Rewrite]
# 只替换 Client= 这一段的取值，Device / DeviceId / Version / Token 全部原样保留。
# 要换伪装目标：把下面各条里的 Filebar 换成别的白名单客户端即可（区分大小写）。
# 可用值：Filebar / SenPlayer / Yamby / Hills / Forward / Emby Web / Emby for iOS
#
# 新版授权头（Emby 4.8+ 及第三方客户端）
^https?://emby3\.69yun69\.com header-replace-regex X-Emby-Authorization Client="[^"]*" Client="Filebar"
# 旧版授权头（部分客户端仍在使用）
^https?://emby3\.69yun69\.com header-replace-regex Authorization Client="[^"]*" Client="Filebar"
# 现代客户端会把客户端名单独下发一次，一并改写
^https?://emby3\.69yun69\.com header-replace X-Emby-Client Filebar
# 兜底：单引号 / 无引号写法（放在最后，前面已改好的不会再次命中）
^https?://emby3\.69yun69\.com header-replace-regex X-Emby-Authorization Client=[^,"]+ Client="Filebar"
^https?://emby3\.69yun69\.com header-replace-regex Authorization Client=[^,"]+ Client="Filebar"
