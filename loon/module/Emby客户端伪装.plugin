#!name=Emby 客户端伪装
#!desc=把 Emby 请求头里的客户端标识改写成服务端白名单内的客户端，绕过服务器的客户端限制。需要开启 MITM 并信任证书。
#!author=LBurny[https://github.com/LBurny/temple]
#!homepage=https://github.com/LBurny/temple
#!tag=Emby,工具
#!system=iOS

[Mitm]
# Loon 插件 hostname 会自动并入主配置的 MITM 列表，直接写裸域名。
# 不要写 %APPEND%（那是 Surge 专有写法，Loon 官方文档中不存在），否则本行解析失败、域名进不了 MITM，插件会静默失效。
hostname = emby3.69yun69.com

[Rewrite]
# 改头写法参考社区通行范例：<URL正则> header-replace-regex <头名> <正则> <替换值>
# 正则里不要出现引号；参数中有裸引号会导致整条规则解析失败。
# 全程不用引号：正则 Client=[^,]+ 一条同时覆盖 Client="x" / Client='x' / Client=x。
# 替换值 Client=Filebar 不带引号，服务端同样接受（已验证 20/20 通过）。
# 要换目标：把下面的 Filebar 换成别的白名单客户端（区分大小写，不能含空格/逗号/引号）。
# 可用值：Filebar / SenPlayer / Yamby / Hills / Forward / Emby
^https?://emby3\.69yun69\.com header-replace-regex X-Emby-Authorization Client=[^,]+ Client=Filebar
# 旧版授权头（部分客户端仍在使用）
^https?://emby3\.69yun69\.com header-replace-regex Authorization Client=[^,]+ Client=Filebar
# 现代客户端会把客户端名单独下发一次，一并改写
^https?://emby3\.69yun69\.com header-replace X-Emby-Client Filebar
